{
    // Shell task to run FastAPI with Uvicorn from the integrated terminal.
    // Use: Terminal → Run Task → "Run API (uvicorn)".
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run API (uvicorn)",
            "type": "shell",
            "command": "python -m uvicorn backend.asgi:app --reload",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    // Keep imports stable when running from the repo root.
                    "PYTHONPATH": "."
                }
            },
            "problemMatcher": []
        }
    ]
}